# Port the API listens on. Default: 3000.
# PORT=3000

# Set to "false" to boot with an empty store instead of generating demo shifts.
# There's currently no other way to get data in (no create-shift endpoint), so this
# stays on by default even when NODE_ENV=production. See api/README.md.
# SEED_DEMO_DATA=false

# Allowed CORS origin(s). Defaults to "*" (no auth/cookies to leak, so open by default).
# Restrict this once there's a specific web client to lock down to.
# CORS_ORIGIN=https://example.com

# pino log level (trace|debug|info|warn|error|fatal). Default: info.
# LOG_LEVEL=debug
