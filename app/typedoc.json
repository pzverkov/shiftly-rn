{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Shiftly - API reference",
  "entryPointStrategy": "expand",
  "entryPoints": ["src"],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.tsx",
    "**/*.bench.mts",
    "**/testFixtures.ts"
  ],
  "out": "docs/api",
  "readme": "README.md",
  "excludePrivate": true,
  "excludeInternal": true,
  "skipErrorChecking": true,
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": false
  }
}
